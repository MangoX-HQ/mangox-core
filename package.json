  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "tsx --watch src/index.ts",
    "dev": "concurrently \"./node_modules/.bin/tsc --watch --noEmit\" \"./node_modules/.bin/nodemon --exec ./node_modules/.bin/tsx src/index.ts\"",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generator": "npm run generator:alias",
    "generator:alias": "npx ts-node src/generators/alias/batchGenerator.ts",
    "security-check": "semgrep scan --config \"p/typescript\" --config \"p/owasp-top-ten\" --config \"p/secrets\" --config \"p/nodejsscan\" ",
    "mongox": "tsx src/core_v2/schema/mongox.ts"
  },
