{
  "watch": ["src"],
  "ext": "ts,js,json",
  "ignore": [
    "logs/**/*",
    "node_modules/**/*",
    "dist/**/*",
    "test/**/*",
    "*.test.ts",
    "*.spec.ts",
    "src/js/**/*",
    "src/core/js/**/*",
    "src/swagger/*",
    "src/vm/production/functions/*"
  ],
  "exec": "tsx src/index.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 5000,
  "signal": "SIGTERM"
}
