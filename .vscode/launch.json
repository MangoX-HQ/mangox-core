{
    "version": "0.2.0",
    "configurations": [
    
      {
        "type": "node",
        "request": "launch",
        "name": "Debug NestJS (start:dev)",
        "runtimeExecutable": "yarn",
        "runtimeArgs": ["run", "start:dev", "--", "--inspect=9229"],
        "console": "integratedTerminal",
        "restart": true,
        "protocol": "inspector",
        "port": 9229,
        "autoAttachChildProcesses": true
      }
    ]
  }
  