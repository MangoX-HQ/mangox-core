{
  "slug": "policy-tenant-list-team-member",
  "title": "Tenant list — team member (admin/manager/user gộp)",
  "description": "1 policy duy nhất cover 3 role team_*. Load 3 data query (admin teams, manager assigned, user tenant_roles), OR lại trong filter.",
  "role": ["team_admin", "team_manager", "team_user"],
  "resource": ["tenant"],
  "action": ["list"],
  "method": null,
  "root_entity": ["tenant"],
  "data": [
    {
      "entity": "user_team",
      "condtion": "user_id=eq.@options:user_id&role_name=eq.admin&is_active=neq.false",
      "alias": "my_admin_teams"
    },
    {
      "entity": "user_team",
      "condtion": "user_id=eq.@options:user_id&role_name=eq.manager&is_active=neq.false",
      "alias": "my_manager_teams"
    },
    {
      "entity": "user_team",
      "condtion": "user_id=eq.@options:user_id&role_name=eq.user&is_active=neq.false",
      "alias": "my_user_teams"
    }
  ],
  "condition": "select=*,team_id(title,slug),created_by(username,full_name,email),updated_by(username,full_name,email)&or=(team_id=in.@context:my_admin_teams:data:team_id,_id=in.@context:my_manager_teams:data:assigned_tenants,_id=in.@context:my_user_teams:data:tenant_roles:tenant_id)",
  "conditions": null,
  "filter": null,
  "is_active": true,
  "system": true
}
