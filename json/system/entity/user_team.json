{
  "title": "User Team Membership",
  "collection_name": "user_team",
  "mongodb_save_data": "user_team",
  "databaseType": "mongodb",
  "public_entity": true,
  "use_timestamp": false,
  "use_slug": false,
  "use_locale": false,
  "use_block": false,
  "use_posttype": false,
  "use_parent": false,
  "use_parent_delete_childs": false,
  "use_sync_relationship_multiply_language": false,
  "use_import": false,
  "comment_mode": false,
  "system": true,
  "json_schema": {
    "type": "object",
    "required": [
      "user_id",
      "team_id",
      "role_name"
    ],
    "dependencies": {},
    "properties": {
      "user_id": {
        "title": "User",
        "type": "string",
        "typeRelation": {
          "_id": "user",
          "title": "user",
          "type": "1-1"
        },
        "widget": "relation",
        "typeSelect": "single",
        "filter": true
      },
      "team_id": {
        "title": "Team",
        "type": "string",
        "typeRelation": {
          "_id": "team",
          "title": "team",
          "type": "1-1"
        },
        "widget": "relation",
        "typeSelect": "single",
        "filter": true
      },
      "role_name": {
        "title": "Role",
        "type": "string",
        "widget": "select",
        "choices": [
          {
            "key": "admin",
            "value": "admin"
          },
          {
            "key": "manager",
            "value": "manager"
          },
          {
            "key": "user",
            "value": "user"
          }
        ],
        "default": "user",
        "filter": true,
        "description": "admin = full team; manager = assigned tenants; user = via user_tenant"
      },
      "assigned_tenants": {
        "title": "Assigned Tenants",
        "type": "array",
        "items": {
          "type": "string"
        },
        "typeRelation": {
          "_id": "tenant",
          "title": "tenant",
          "type": "1-n"
        },
        "widget": "relation",
        "typeSelect": "multiple",
        "filter": true,
        "description": "Tenants manager này được gán (chỉ dùng cho role=manager)"
      },
      "tenant_roles": {
        "title": "Per-tenant Roles",
        "type": "array",
        "description": "Role chi tiết của user trong từng tenant của team. Dùng cho role=user (editor/viewer/...). Admin/manager bypass.",
        "items": {
          "type": "object",
          "required": [
            "tenant_id",
            "role_name"
          ],
          "properties": {
            "tenant_id": {
              "type": "string",
              "title": "Tenant",
              "typeRelation": {
                "_id": "tenant",
                "title": "tenant",
                "type": "1-1"
              },
              "widget": "relation"
            },
            "role_name": {
              "type": "string",
              "title": "Role",
              "widget": "shortAnswer",
              "description": "Role slug trong tenant (vd: editor, viewer, writer, ...). Mỗi tenant tự định nghĩa role riêng — type tay slug có sẵn."
            }
          }
        }
      },
      "username": {
        "title": "Username (denorm)",
        "type": "string",
        "widget": "shortAnswer"
      },
      "full_name": {
        "title": "Full Name (denorm)",
        "type": "string",
        "widget": "shortAnswer"
      },
      "email": {
        "title": "Email (denorm)",
        "type": "string",
        "widget": "shortAnswer"
      }
    }
  },
  "ui_schema": {
    "user_id": {
      "ui:widget": "relation"
    },
    "team_id": {
      "ui:widget": "relation"
    },
    "role_name": {
      "ui:widget": "select"
    },
    "assigned_tenants": {
      "ui:widget": "relation"
    },
    "tenant_roles": {
      "items": {
        "tenant_id": {
          "ui:widget": "relation"
        },
        "role_name": {
          "ui:widget": "shortAnswer"
        },
        "ui:order": [
          "tenant_id",
          "role_name"
        ]
      }
    },
    "username": {
      "ui:widget": "shortAnswer"
    },
    "full_name": {
      "ui:widget": "shortAnswer"
    },
    "email": {
      "ui:widget": "shortAnswer"
    },
    "ui:order": [
      "user_id",
      "team_id",
      "role_name",
      "assigned_tenants",
      "tenant_roles",
      "username",
      "full_name",
      "email"
    ]
  }
}
