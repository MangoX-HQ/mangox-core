{
  "title": "setting tenant read — dispatch policy theo role_name caller trên team-of-tenant",
  "slug": "setting-tenant-read",
  "description": "GET /tenant/:id — chain query: load tenant.team_id → user_team(user_id, team_id) → switch role_name → dispatch policy-tenant-read-full (admin/manager) hoặc policy-tenant-read-basic (user).",
  "resource": "tenant",
  "action": "read",
  "role": "team_admin",
  "context_data_resource": [
    {
      "entity": "tenant",
      "condtion": "_id=eq.@options:resource_id&select=team_id",
      "alias": "current_tenant"
    },
    {
      "entity": "user_team",
      "condtion": "user_id=eq.@options:user_id&team_id=in.@context:current_tenant:data:team_id&is_active=neq.false",
      "alias": "membership"
    }
  ],
  "switch": "membership:data:role_name",
  "case": [
    { "value": "admin", "policy": "policy-tenant-read-full" },
    { "value": "manager", "policy": "policy-tenant-read-full" },
    { "value": "user", "policy": "policy-tenant-read-basic" }
  ],
  "is_active": true,
  "system": true
}
