# syntax = docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Single-tenant tenant-runtime image.
#   - 1 image shared across ALL tenants; per-tenant configuration via --env-file.
#   - Redis-only: schema/config is read directly from Redis (pre-seeded). Do NOT need to mount json/.
#   - SSO public key passed via env SSO_PUBLIC_KEY (inline PEM) → no need to mount a file.
# ─────────────────────────────────────────────────────────────────────────────
ARG NODE_VERSION=22.19.0

FROM node:${NODE_VERSION}-slim AS base
WORKDIR /app
ENV NODE_ENV="production"
RUN npm install -g yarn@1.22.22 --force

# ── Build stage ──────────────────────────────────────────────────────────────
FROM base AS build
RUN apt-get update -qq && apt-get install --no-install-recommends -y \
    build-essential node-gyp pkg-config python-is-python3
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=false
COPY . .
RUN yarn run build
RUN yarn install --production=true

# ── Final image ──────────────────────────────────────────────────────────────
FROM base
COPY --from=build /app/dist /app/dist
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/package.json /app/package.json

# Default port (override via env PORT). The app reads process.env.PORT.
ENV PORT=5557
EXPOSE 5557

# Redis-only: no seeding/reading json at boot.
CMD [ "node", "dist/index.js" ]
