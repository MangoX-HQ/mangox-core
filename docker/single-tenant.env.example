# ── Tenant identity (single-tenant) ──────────────────────────────────────────
TEAM_ID=6a1fcc1cec1661a8ebdb8bac
TENANT=mkt-blog

# ── App ──────────────────────────────────────────────────────────────────────
PORT=5557
NODE_ENV=production
APP_NAME=Mangox API
PREFIX_API=/api/v1

# ── Mongo (tenant's business DB) ──────────────────────────────────────────
MONGODB_URL=mongodb://user:pass@mongo-host:27017/mangoads?authSource=admin

# ── Redis (schema is pre-seeded in this DB — must match scope <TEAM_ID>:<TENANT>) ─────
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=changeme
REDIS_DB=15
REDIS_PREFIX=default
# TLS: enable when managed/cloud Redis uses rediss. INSECURE=true to skip cert verification.
REDIS_TLS=false
# REDIS_TLS_INSECURE=false

# ── SSO: verify JWT RS256 using Studio's public key ─────────────────────────
# Option 1 (recommended for Docker): inline PEM, escape newlines as \n
SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"
# Option 2: mount a file and point to its path
# SSO_PUBLIC_KEY_PATH=/app/sso-public.pem

# ── JWT security ──────────────────────────────────────────────────────────────
# SET a strong secret (do NOT leave empty → avoid HS256 forgery via 'supersecret')
JWT_SECRET=__CHANGE_ME_STRONG_RANDOM__
# Token for the control-plane to call POST /admin/reload (no user token needed)
RELOAD_TOKEN=__CHANGE_ME_RELOAD_TOKEN__

# ── MinIO / R2 (media) ───────────────────────────────────────────────────────
STORAGE_MODE=minio
MINIO_ENDPOINT=https://xxx.r2.cloudflarestorage.com
MINIO_USE_SSL=true
MINIO_REGION=auto
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC=
MINIO_BUCKET_NAME=mangox-live
